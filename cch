#!/bin/bash
# cch - Claude/Codex conversation history search
# Interactive fuzzy search through local assistant conversation history
# Usage: cch [options] [initial_query ...]

set -o pipefail

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude/projects}"
CODEX_DIR="${CODEX_DIR:-$HOME/.codex/sessions}"
KIRO_DIR="${KIRO_DIR:-$HOME/.kiro/sessions}"
KIRO_BIN="${CCH_KIRO_BIN:-kiro-cli}"
CACHE_DIR="${CCH_CACHE_DIR:-$HOME/.cache/cch}"
INDEX_FILE="$CACHE_DIR/index.lines"
PREVIEW_DIR="$CACHE_DIR/previews"
MAP_FILE="$CACHE_DIR/map.tsv"
VERSION_FILE="$CACHE_DIR/version"
CACHE_VERSION="3"
SOURCE="${CCH_SOURCE:-all}"
FORCE_REBUILD=0
PRINT_CACHE=0
KIRO_TAKEOVER="${CCH_KIRO_TAKEOVER:-1}"
BLACKLIST_FILE="${CCH_BLACKLIST_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/cch/blacklist}"
BLACKLIST_ENABLED=1

usage() {
    cat <<USAGE
cch - search Claude Code, Codex, and Kiro conversation history

Usage:
  cch [options] [initial query...]

Options:
  -s, --source SOURCE   Source to search: all, claude, codex, kiro (default: all)
  -r, --rebuild         Force rebuild cache before searching
      --no-takeover     Do not close the process holding a locked Kiro session
      --no-blacklist    Do not filter sessions matching blacklist keywords
      --clean           Remove cch cache and rebuild
      --cache           Print cache directory and exit
  -h, --help            Show this help

Keys:
  Enter   output resume command
  Ctrl-R  directly resume selected conversation
  Ctrl-P  output preview file path
  Ctrl-J  output raw JSONL file path

Environment:
  CLAUDE_DIR     Claude history dir (default: ~/.claude/projects)
  CODEX_DIR      Codex history dir (default: ~/.codex/sessions)
  KIRO_DIR       Kiro history dir (default: ~/.kiro/sessions)
  CCH_KIRO_BIN   Kiro CLI binary for resume (default: kiro-cli)
  CCH_CACHE_DIR  Cache dir (default: ~/.cache/cch)
  CCH_SOURCE     Default source: all, claude, codex, kiro
  CCH_KIRO_TAKEOVER  Set to 0 to refuse instead of closing a locked Kiro session
  CCH_BLACKLIST      Newline-separated keywords; sessions whose first message contains any are hidden
  CCH_BLACKLIST_FILE Blacklist file path (default: ~/.config/cch/blacklist)
USAGE
}

missing_dependency() {
    dep="$1"
    echo "Error: required dependency '$dep' is not installed or not in PATH." >&2
    echo >&2
    case "$dep" in
        fzf)
            echo "Install fzf with one of:" >&2
            echo "  macOS Homebrew:  brew install fzf" >&2
            echo "  macOS MacPorts:  sudo port install fzf" >&2
            echo "  Ubuntu/Debian:   sudo apt install fzf" >&2
            echo "  Fedora:          sudo dnf install fzf" >&2
            echo "  Arch:            sudo pacman -S fzf" >&2
            ;;
        python3)
            echo "Install Python 3 with your system package manager." >&2
            echo "  macOS Homebrew:  brew install python" >&2
            echo "  Ubuntu/Debian:   sudo apt install python3" >&2
            ;;
    esac
    exit 127
}

# Emit blacklist keywords, one per line, trimmed and with blanks/comments
# removed. Sources: the blacklist file (# starts a comment) and the newline
# separated CCH_BLACKLIST env var. A session whose first message contains any
# of these (case-insensitively) is hidden from the fzf list.
blacklist_patterns() {
    {
        if [ -f "$BLACKLIST_FILE" ]; then
            cat "$BLACKLIST_FILE"
        fi
        if [ -n "${CCH_BLACKLIST:-}" ]; then
            printf '%s\n' "$CCH_BLACKLIST"
        fi
    } | sed 's/^[[:space:]]*//; s/[[:space:]]*$//; /^#/d; /^$/d'
}

# Path of the lock file kiro-cli writes next to a session while it is open.
kiro_lock_path() {
    sid="$1"
    jsonl="$2"
    if [ -n "$jsonl" ]; then
        printf '%s\n' "${jsonl%.jsonl}.lock"
    else
        printf '%s\n' "$KIRO_DIR/cli/$sid.lock"
    fi
}

# Print the PID recorded in a Kiro session lock file, but only when that
# process is still alive and still looks like a kiro-cli process. A stale lock
# (owner gone, or PID recycled by something else) prints nothing.
kiro_active_lock_pid() {
    lock_file="$1"
    [ -f "$lock_file" ] || return 0
    lock_pid=$(sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$lock_file" | head -1)
    [ -n "$lock_pid" ] || return 0
    kill -0 "$lock_pid" 2>/dev/null || return 0
    case "$(ps -o args= -p "$lock_pid" 2>/dev/null)" in
        *kiro*) printf '%s\n' "$lock_pid" ;;
    esac
}

# The lock records the `kiro-cli-chat acp` helper PID. Walk up to the
# interactive `kiro-cli chat` process the user can actually see and quit.
kiro_lock_owner_pid() {
    owner_pid="$1"
    while :; do
        owner_ppid=$(ps -o ppid= -p "$owner_pid" 2>/dev/null | tr -d ' ')
        case "$owner_ppid" in
            ''|0|1) break ;;
        esac
        case "$(ps -o args= -p "$owner_ppid" 2>/dev/null)" in
            *kiro-cli*) owner_pid="$owner_ppid" ;;
            *) break ;;
        esac
    done
    printf '%s\n' "$owner_pid"
}

# Free a session lock held by a live kiro-cli process so the session can be
# resumed here. Asks the interactive process to quit first, escalates to
# SIGKILL if it ignores that, then drops any lock file left behind. Conversation
# history is flushed to the .jsonl store as it happens, so nothing is lost.
kiro_takeover_lock() {
    take_acp_pid="$1"
    take_lock="$2"
    take_pid=$(kiro_lock_owner_pid "$take_acp_pid")
    take_tty=$(ps -o tty= -p "$take_pid" 2>/dev/null | tr -d ' ')
    if [ -n "$take_tty" ] && [ "$take_tty" != "?" ]; then
        echo "cch: session was open in PID $take_pid (tty $take_tty), closing it to take over" >&2
    else
        echo "cch: session was open in PID $take_pid, closing it to take over" >&2
    fi
    kill "$take_pid" 2>/dev/null
    take_waited=0
    while [ "$take_waited" -lt 50 ]; do
        kill -0 "$take_pid" 2>/dev/null || break
        sleep 0.1
        take_waited=$((take_waited + 1))
    done
    if kill -0 "$take_pid" 2>/dev/null; then
        echo "cch: PID $take_pid ignored SIGTERM, sending SIGKILL" >&2
        kill -9 "$take_pid" 2>/dev/null
        sleep 0.3
    fi
    # The lock is owned by the `kiro-cli-chat acp` helper; make sure it is gone.
    if kill -0 "$take_acp_pid" 2>/dev/null; then
        kill -9 "$take_acp_pid" 2>/dev/null
        sleep 0.3
    fi
    if [ -n "$(kiro_active_lock_pid "$take_lock")" ]; then
        echo "Error: Kiro session lock is still held after closing PID $take_pid." >&2
        echo "Inspect it with: cat $take_lock" >&2
        return 1
    fi
    rm -f "$take_lock"
    return 0
}

# Used with --no-takeover: explain why we refuse, and how to get unstuck.
# Without any check kiro-cli sits at "Initializing..." forever: the ACP layer
# does reject the load with "Session is active in another process (PID N)", but
# the TUI never shows the error, it only lands in /tmp/kiro-log/kiro-tui.log.
kiro_report_locked() {
    holder_pid=$(kiro_lock_owner_pid "$1")
    locked_sid="$2"
    locked_cwd="$3"
    holder_tty=$(ps -o tty= -p "$holder_pid" 2>/dev/null | tr -d ' ')
    holder_started=$(ps -o lstart= -p "$holder_pid" 2>/dev/null | sed 's/^[[:space:]]*//')
    {
        echo "Error: Kiro session $locked_sid is already open in another process."
        printf 'Holder: PID %s' "$holder_pid"
        if [ -n "$holder_tty" ] && [ "$holder_tty" != "?" ]; then
            printf ' on tty %s' "$holder_tty"
        fi
        if [ -n "$holder_started" ]; then
            printf ' (started %s)' "$holder_started"
        fi
        echo
        echo
        echo "Resuming it would hang at 'Initializing...' because the session lock is held."
        echo "Options:"
        if [ -n "$holder_tty" ] && [ "$holder_tty" != "?" ]; then
            echo "  1. Go back to /dev/$holder_tty and keep using the session there."
        fi
        echo "  2. Quit that session, or run: kill $holder_pid   (history is already on disk)"
        printf '  3. Read it without the TUI: cd %q && %q chat --trust-all-tools --resume-id %q --no-interactive "<prompt>"\n' \
            "$locked_cwd" "$KIRO_BIN" "$locked_sid"
        echo "  4. Let cch close it for you: drop --no-takeover (the default)."
    } >&2
}

query_parts=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -s|--source)
            if [ -z "${2:-}" ]; then
                echo "Error: --source requires all, claude, codex, or kiro" >&2
                exit 2
            fi
            SOURCE="$2"
            shift 2
            ;;
        --source=*)
            SOURCE="${1#*=}"
            shift
            ;;
        -r|--rebuild)
            FORCE_REBUILD=1
            shift
            ;;
        --no-takeover)
            KIRO_TAKEOVER=0
            shift
            ;;
        --no-blacklist)
            BLACKLIST_ENABLED=0
            shift
            ;;
        --clean)
            rm -rf "$CACHE_DIR"
            FORCE_REBUILD=1
            shift
            ;;
        --cache)
            PRINT_CACHE=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            query_parts+=("$@")
            break
            ;;
        *)
            query_parts+=("$1")
            shift
            ;;
    esac
done

case "$SOURCE" in
    all|claude|codex|kiro) ;;
    *)
        echo "Error: invalid source '$SOURCE' (expected all, claude, codex, or kiro)" >&2
        exit 2
        ;;
esac

for dep in python3 fzf; do
    command -v "$dep" >/dev/null 2>&1 || missing_dependency "$dep"
done

if [ ! -d "$CLAUDE_DIR" ] && [ ! -d "$CODEX_DIR" ] && [ ! -d "$KIRO_DIR" ]; then
    echo "Error: none of $CLAUDE_DIR, $CODEX_DIR, or $KIRO_DIR exists" >&2
    exit 1
fi

mkdir -p "$CACHE_DIR" "$PREVIEW_DIR"

if [ "$PRINT_CACHE" -eq 1 ]; then
    echo "$CACHE_DIR"
    exit 0
fi

rebuild=$FORCE_REBUILD
if [ ! -f "$INDEX_FILE" ] || [ ! -f "$MAP_FILE" ] || [ ! -f "$VERSION_FILE" ] || [ "$(cat "$VERSION_FILE" 2>/dev/null)" != "$CACHE_VERSION" ]; then
    rebuild=1
else
    if [ -d "$CLAUDE_DIR" ]; then
        latest_claude=$(find "$CLAUDE_DIR" -name "*.jsonl" -newer "$INDEX_FILE" -print -quit 2>/dev/null)
        [ -n "$latest_claude" ] && rebuild=1
    fi
    if [ -d "$CODEX_DIR" ]; then
        latest_codex=$(find "$CODEX_DIR" -name "*.jsonl" -newer "$INDEX_FILE" -print -quit 2>/dev/null)
        [ -n "$latest_codex" ] && rebuild=1
    fi
    if [ -d "$KIRO_DIR" ]; then
        latest_kiro=$(find "$KIRO_DIR" -name "*.jsonl" -newer "$INDEX_FILE" -print -quit 2>/dev/null)
        [ -n "$latest_kiro" ] && rebuild=1
    fi
fi

if [ "$rebuild" -eq 1 ]; then
    python3 - "$CLAUDE_DIR" "$CODEX_DIR" "$KIRO_DIR" "$INDEX_FILE" "$PREVIEW_DIR" "$MAP_FILE" "$VERSION_FILE" "$CACHE_VERSION" <<'PYTHON'
import json
import os
import re
import sys
import glob
import shutil
from pathlib import Path
from datetime import datetime

claude_dir, codex_dir, kiro_dir, index_file, preview_dir, map_file, version_file, cache_version = sys.argv[1:]
mtime_file = map_file + '.mtime'

CONTROL_PREFIXES = (
    '# AGENTS.md instructions',
    '<environment_context>',
    '<permissions instructions>',
    '<collaboration_mode>',
    '<skills_instructions>',
)


def one_line(text, limit=None):
    if text is None:
        return ''
    if not isinstance(text, str):
        text = str(text)
    text = text.replace('\r', ' ').replace('\n', ' ').replace('\t', ' ')
    text = re.sub(r'\s+', ' ', text).strip()
    if limit is not None:
        return text[:limit]
    return text


def safe_field(text):
    return one_line(text).replace('\t', ' ')


def should_skip_text(text):
    stripped = text.lstrip()
    return any(stripped.startswith(prefix) for prefix in CONTROL_PREFIXES)


def content_to_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for item in content:
            if not isinstance(item, dict):
                continue
            item_type = item.get('type')
            if item_type in ('text', 'input_text', 'output_text'):
                parts.append(item.get('text', ''))
        return ' '.join(parts)
    return ''


def kiro_content_to_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for item in content:
            if not isinstance(item, dict):
                continue
            if item.get('kind') == 'text':
                data = item.get('data', '')
                if isinstance(data, str):
                    parts.append(data)
        return ' '.join(parts)
    return ''


def load_existing():
    existing = {}
    if os.path.exists(mtime_file):
        with open(mtime_file, 'r', encoding='utf-8', errors='ignore') as handle:
            for line in handle:
                parts = line.rstrip('\n').split('\t')
                if len(parts) == 4:
                    existing[(parts[0], parts[1])] = (parts[2], float(parts[3]))
                elif len(parts) == 3:
                    existing[(parts[0], parts[1])] = (parts[1], float(parts[2]))
                elif len(parts) == 2:
                    existing[('claude', parts[0])] = (parts[0], float(parts[1]))
    return existing


def cache_name(source, session_id):
    return f'{source}-{session_id}'


def read_cached_session(source, session_id, mtime, path):
    name = cache_name(source, session_id)
    preview_path = os.path.join(preview_dir, name)
    search_path = preview_path + '.search'
    cwd_path = preview_path + '.cwd'
    if not os.path.exists(preview_path):
        return None
    first_line = ''
    with open(preview_path, 'r', encoding='utf-8', errors='ignore') as preview:
        for line in preview:
            if line.startswith('First:'):
                first_line = one_line(line[6:], 120)
                break
    search_keywords = ''
    if os.path.exists(search_path):
        with open(search_path, 'r', encoding='utf-8', errors='ignore') as search:
            search_keywords = one_line(search.read(), 2000)
    cwd = ''
    if os.path.exists(cwd_path):
        with open(cwd_path, 'r', encoding='utf-8', errors='ignore') as cwd_file:
            cwd = one_line(cwd_file.read())
    date_str = datetime.fromtimestamp(mtime).strftime('%Y-%m-%d %H:%M')
    return (mtime, source, session_id, cwd, path, date_str, first_line, search_keywords)


def write_cached_session(source, session_id, cwd, path, date_str, first_user_msg, messages, search_keywords):
    name = cache_name(source, session_id)
    preview_path = os.path.join(preview_dir, name)
    with open(preview_path, 'w', encoding='utf-8') as preview:
        preview.write(f'Source:  {source}\n')
        preview.write(f'Session: {session_id}\n')
        preview.write(f'CWD:     {cwd}\n')
        preview.write(f'File:    {path}\n')
        preview.write(f'Date:    {date_str}\n')
        preview.write(f'First:   {first_user_msg}\n')
        preview.write(f"\n{'─' * 50}\n\n")
        for role, msg in messages[:30]:
            preview.write(f'{role}: {one_line(msg, 300)}\n\n')
    with open(preview_path + '.search', 'w', encoding='utf-8') as search:
        search.write(search_keywords)
    with open(preview_path + '.cwd', 'w', encoding='utf-8') as cwd_file:
        cwd_file.write(cwd)


def parse_claude(path):
    session_id = Path(path).stem
    cwd = ''
    messages = []
    first_user_msg = ''
    with open(path, 'r', encoding='utf-8', errors='ignore') as handle:
        for line in handle:
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not cwd and obj.get('cwd'):
                cwd = one_line(obj.get('cwd'))
            msg_type = obj.get('type')
            if msg_type not in ('user', 'assistant'):
                continue
            content = content_to_text(obj.get('message', {}).get('content', ''))
            if should_skip_text(content):
                continue
            text = one_line(content, 600)
            if not text:
                continue
            messages.append((msg_type, text))
            if msg_type == 'user' and not first_user_msg:
                first_user_msg = one_line(content, 120)
    return session_id, cwd, messages, first_user_msg


def parse_codex(path):
    session_id = Path(path).stem
    cwd = ''
    messages = []
    first_user_msg = ''
    with open(path, 'r', encoding='utf-8', errors='ignore') as handle:
        for line in handle:
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            payload = obj.get('payload') or {}
            record_type = obj.get('type')
            if record_type == 'session_meta':
                session_id = payload.get('id') or session_id
                cwd = cwd or one_line(payload.get('cwd', ''))
                continue
            if record_type == 'turn_context':
                cwd = cwd or one_line(payload.get('cwd', ''))
                continue
            if record_type != 'response_item':
                continue
            if payload.get('type') != 'message':
                continue
            role = payload.get('role')
            if role not in ('user', 'assistant'):
                continue
            content = content_to_text(payload.get('content', []))
            if should_skip_text(content):
                continue
            text = one_line(content, 600)
            if not text:
                continue
            messages.append((role, text))
            if role == 'user' and not first_user_msg:
                first_user_msg = one_line(content, 120)
    return session_id, cwd, messages, first_user_msg


def parse_kiro(path):
    session_id = Path(path).stem
    cwd = ''
    messages = []
    first_user_msg = ''
    title = ''
    meta_path = os.path.splitext(path)[0] + '.json'
    if os.path.exists(meta_path):
        try:
            with open(meta_path, 'r', encoding='utf-8', errors='ignore') as meta_handle:
                meta = json.load(meta_handle)
            if isinstance(meta, dict):
                session_id = meta.get('session_id') or session_id
                cwd = one_line(meta.get('cwd', '')) or cwd
                title = one_line(meta.get('title', ''))
        except Exception:
            pass
    with open(path, 'r', encoding='utf-8', errors='ignore') as handle:
        for line in handle:
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            kind = obj.get('kind')
            if kind == 'Prompt':
                role = 'user'
            elif kind == 'AssistantMessage':
                role = 'assistant'
            else:
                continue
            data = obj.get('data') or {}
            content = kiro_content_to_text(data.get('content', []))
            if should_skip_text(content):
                continue
            text = one_line(content, 600)
            if not text:
                continue
            messages.append((role, text))
            if role == 'user' and not first_user_msg:
                first_user_msg = one_line(content, 120)
    if not first_user_msg and title:
        first_user_msg = title
    return session_id, cwd, messages, first_user_msg


def iter_paths(source, root):
    if not os.path.isdir(root):
        return []
    return glob.glob(os.path.join(root, '**', '*.jsonl'), recursive=True)

existing = load_existing()
sessions = []
seen_keys = set()
updated = 0
reused = 0

for source, root, parser in (
    ('claude', claude_dir, parse_claude),
    ('codex', codex_dir, parse_codex),
    ('kiro', kiro_dir, parse_kiro),
):
    for jsonl_path in iter_paths(source, root):
        try:
            mtime = os.path.getmtime(jsonl_path)
            guessed_id = Path(jsonl_path).stem
            cache_key = (source, jsonl_path)
            cached = None
            if cache_key in existing:
                cached_id, cached_mtime = existing[cache_key]
                if abs(cached_mtime - mtime) < 1:
                    cached = read_cached_session(source, cached_id, mtime, jsonl_path)
            legacy_key = (source, guessed_id)
            if cached is None and legacy_key in existing:
                cached_id, cached_mtime = existing[legacy_key]
                if abs(cached_mtime - mtime) < 1:
                    cached = read_cached_session(source, cached_id, mtime, jsonl_path)
            if cached is not None:
                sessions.append(cached)
                seen_keys.add((source, cached[2]))
                reused += 1
                continue

            session_id, cwd, messages, first_user_msg = parser(jsonl_path)
            if not messages:
                continue
            if not first_user_msg:
                first_user_msg = messages[0][1]
            date_str = datetime.fromtimestamp(mtime).strftime('%Y-%m-%d %H:%M')
            search_keywords = one_line(' '.join(msg for _, msg in messages), 3000)
            write_cached_session(source, session_id, cwd, jsonl_path, date_str, first_user_msg, messages, search_keywords)
            sessions.append((mtime, source, session_id, cwd, jsonl_path, date_str, first_user_msg, search_keywords))
            seen_keys.add((source, session_id))
            updated += 1
        except Exception:
            continue

# Clean previews from removed sessions and old cache versions.
valid_names = {cache_name(source, session_id) for _, source, session_id, *_ in sessions}
if os.path.isdir(preview_dir):
    for entry in os.listdir(preview_dir):
        base = entry
        for suffix in ('.search', '.cwd'):
            if base.endswith(suffix):
                base = base[:-len(suffix)]
        if base not in valid_names:
            path = os.path.join(preview_dir, entry)
            if os.path.isfile(path):
                os.remove(path)
            elif os.path.isdir(path):
                shutil.rmtree(path)

sessions.sort(key=lambda row: row[0], reverse=True)

with open(index_file, 'w', encoding='utf-8') as index, \
     open(map_file, 'w', encoding='utf-8') as mapping, \
     open(mtime_file, 'w', encoding='utf-8') as mtimes:
    for i, (mtime, source, session_id, cwd, path, date_str, first_user_msg, search_keywords) in enumerate(sessions):
        line = f'[{source}] [{date_str}] {one_line(first_user_msg, 100)} | {search_keywords}'
        index.write(line + '\n')
        mapping.write('\t'.join([str(i), source, safe_field(session_id), safe_field(cwd), safe_field(path)]) + '\n')
        mtimes.write('\t'.join([source, safe_field(path), safe_field(session_id), str(mtime)]) + '\n')

with open(version_file, 'w', encoding='utf-8') as version:
    version.write(cache_version)

sys.stderr.write(f'Indexed {len(sessions)} sessions (updated: {updated}, reused: {reused})\n')
PYTHON
fi

if [ ! -s "$INDEX_FILE" ]; then
    echo "No conversations indexed" >&2
    exit 1
fi

query="${query_parts[*]}"
filter_cmd=(cat -n "$INDEX_FILE")
if [ "$SOURCE" != "all" ]; then
    filter_cmd=(awk -v src="[$SOURCE]" '{ if ($1 == src) print NR "\t" $0 }' "$INDEX_FILE")
fi

# Drop sessions whose first message matches any blacklist keyword. Matching is
# limited to the first-message segment (everything before " | " in the index
# line) so a keyword that merely appears in the conversation body does not hide
# an otherwise wanted session. Line numbers are already prepended (cat -n / NR)
# so removing lines here keeps the map.tsv lookup valid.
blacklist_filter=(cat)
blacklist_tmp=""
if [ "$BLACKLIST_ENABLED" -eq 1 ]; then
    patterns=$(blacklist_patterns)
    if [ -n "$patterns" ]; then
        blacklist_tmp=$(mktemp "${TMPDIR:-/tmp}/cch-blacklist.XXXXXX")
        trap 'rm -f "$blacklist_tmp"' EXIT
        printf '%s\n' "$patterns" > "$blacklist_tmp"
        blacklist_filter=(awk -v plist="$blacklist_tmp" '
            BEGIN {
                n = 0
                while ((getline p < plist) > 0) {
                    if (length(p) > 0) pats[++n] = tolower(p)
                }
            }
            {
                sep = index($0, " | ")
                seg = (sep > 0) ? substr($0, 1, sep - 1) : $0
                lseg = tolower(seg)
                for (i = 1; i <= n; i++) {
                    if (index(lseg, pats[i]) > 0) next
                }
                print
            }
        ')
    fi
fi

selected=$("${filter_cmd[@]}" | "${blacklist_filter[@]}" | \
    fzf --query="$query" \
        --exact \
        -i \
        --preview="line_num=\$(echo {} | awk '{print \$1}'); sid=\$(awk -F'\t' -v n=\"\$((line_num - 1))\" 'NR==n+1 {print \$3}' '$MAP_FILE'); src=\$(awk -F'\t' -v n=\"\$((line_num - 1))\" 'NR==n+1 {print \$2}' '$MAP_FILE'); cat '$PREVIEW_DIR'/\$src-\$sid 2>/dev/null || echo 'No preview'" \
        --preview-window=right:wrap:55% \
        --header=$'Enter: 输出恢复命令\nCtrl-R: 直接恢复\nCtrl-P: 输出预览文件\nCtrl-J: 输出原始 JSONL\nCtrl-C: 退出' \
        --tiebreak=index \
        --no-sort \
        --nth=2.. \
        --expect=ctrl-r,ctrl-p,ctrl-j)

if [ -n "$selected" ]; then
    key=$(echo "$selected" | head -1)
    line=$(echo "$selected" | tail -1)
    line_num=$(echo "$line" | awk '{print $1}')
    map_row=$(awk -F'\t' -v n="$((line_num - 1))" 'NR==n+1 {print}' "$MAP_FILE")
    source=$(printf '%s\n' "$map_row" | awk -F'\t' '{print $2}')
    session_id=$(printf '%s\n' "$map_row" | awk -F'\t' '{print $3}')
    cwd=$(printf '%s\n' "$map_row" | awk -F'\t' '{print $4}')
    jsonl_path=$(printf '%s\n' "$map_row" | awk -F'\t' '{print $5}')

    if [ -z "$cwd" ] || [ ! -d "$cwd" ]; then
        cwd="$HOME"
    fi

    preview_path="$PREVIEW_DIR/$source-$session_id"
    if [ "$key" = "ctrl-p" ]; then
        echo "$preview_path"
    elif [ "$key" = "ctrl-j" ]; then
        echo "$jsonl_path"
    elif [ "$source" = "codex" ]; then
        if [ "$key" = "ctrl-r" ]; then
            cd "$cwd" && exec codex resume --dangerously-bypass-approvals-and-sandbox "$session_id"
        else
            printf 'cd %q && codex resume --dangerously-bypass-approvals-and-sandbox %q\n' "$cwd" "$session_id"
        fi
    elif [ "$source" = "kiro" ]; then
        session_lock=$(kiro_lock_path "$session_id" "$jsonl_path")
        held_pid=$(kiro_active_lock_pid "$session_lock")
        if [ -n "$held_pid" ]; then
            if [ "$KIRO_TAKEOVER" != "0" ]; then
                kiro_takeover_lock "$held_pid" "$session_lock" || exit 1
            else
                kiro_report_locked "$held_pid" "$session_id" "$cwd"
                exit 1
            fi
        fi
        if [ "$key" = "ctrl-r" ]; then
            cd "$cwd" && exec "$KIRO_BIN" chat --trust-all-tools --resume-id "$session_id"
        else
            printf 'cd %q && %q chat --trust-all-tools --resume-id %q\n' "$cwd" "$KIRO_BIN" "$session_id"
        fi
    else
        if [ "$key" = "ctrl-r" ]; then
            cd "$cwd" && exec claude --dangerously-skip-permissions --resume "$session_id"
        else
            printf 'cd %q && claude --dangerously-skip-permissions --resume %q\n' "$cwd" "$session_id"
        fi
    fi
fi
